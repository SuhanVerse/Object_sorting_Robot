# Arduino build products and local tools
build/
.arduino/
.pio/
*.hex
*.elf
*.bin
*.map
compile_commands.json

# Local credentials and editor state
.source-assets/
.env
.env.*
!.env.example
secrets.h
.vscode/
.idea/
__pycache__/
