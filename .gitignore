# LaTeX intermediates; PDFs and source are tracked
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# New Blender autosaves; retain the recovered backup
*.blend[0-9]*
!hardware/mechanical/conveyer_belt.blend1
*.blend@

# Preserve local Blender edits without publishing backup copies
hardware/mechanical/.local-backups/
